# =========================================================
# SISTEMA INVENTARIO WEB - VARIABLES DE ENTORNO
# Copiar este archivo como .env y completar los valores.
# .env NUNCA se sube a GitHub (está en .gitignore).
# =========================================================

# --- Aplicación ---
# local | produccion  (en produccion no se muestran errores en pantalla)
APP_ENV=local
APP_DEBUG=true
# URL pública del sistema, sin "/" al final.
# Local:      http://localhost/sistema-inventario-web
# Producción: https://CUENTA.alwaysdata.net
APP_URL=http://localhost/sistema-inventario-web
APP_TIMEZONE=America/Guayaquil

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=inventario_web
DB_USERNAME=root
DB_PASSWORD=

# --- Correo SMTP (recuperación de contraseña) ---
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
# tls (STARTTLS, puerto 587) | ssl (puerto 465) | ninguno (solo pruebas locales)
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Sistema Inventario Web"

# --- Respaldos ---
# Carpeta donde se guardan los .sql. En producción debe estar FUERA
# de la carpeta pública, por ejemplo: /home/CUENTA/respaldos
# Si se deja vacío se usa la carpeta respaldos/ del proyecto.
BACKUP_DIR=
# Ruta a mysqldump. En XAMPP (Windows):
# MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
MYSQLDUMP_PATH=mysqldump
